  "description": "Deterministic spherical gravity physics engine, procedural icosphere terrain pipeline, and WebGL numerical simulation framework",
  "type": "module",
  "main": "src/js/engine.js",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test test/*.test.js",
