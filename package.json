    "lint": "node --check src/js/*.js test/*.test.js"
  },
  "keywords": [
    "physics-engine",
    "numerical-simulation",
    "spherical-gravity",
    "computational-geometry",
    "procedural-mesh-generation",
    "icosphere-pipeline",
    "webgl",
    "threejs",
    "simulation-framework"
  ],
